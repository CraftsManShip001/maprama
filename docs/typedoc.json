{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "entryPoints": ["../packages/protocol/src/index.ts", "../packages/react-native/src/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "./typedoc.tsconfig.json",
  "out": "./api/reference",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme", "./scripts/typedoc-module-names.mjs"],
  "docsRoot": ".",
  "sidebar": { "autoConfiguration": true, "format": "vitepress", "pretty": true, "collapsed": true },
  "name": "Diorama API reference",
  "readme": "none",
  "entryFileName": "index",
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "disableSources": true,
  "skipErrorChecking": true,
  "hidePageHeader": true,
  "useCodeBlocks": true,
  "parametersFormat": "table",
  "enumMembersFormat": "table",
  "typeDeclarationFormat": "table",
  "sanitizeComments": true,
  "cleanOutputDir": true,
  "githubPages": false,
  "logLevel": "Warn"
}
